# ============================================================
# Docker environment — copy from .env.local and adjust values.
# Used by: docker compose --env-file web/.env.docker
# ============================================================

# ── Supabase (client-side) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Supabase Service Role (server-side only) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Resend (email) ──────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Afri Connect <onboarding@resend.dev>

# ── Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (for migrations) ────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Redis (set automatically by docker-compose, override here if needed) ──
# REDIS_URL=redis://redis:6379

# ── MFA / OTP ────────────────────────────────────────────────
# Set to 'true' to bypass OTP for all users while email is not configured.
DISABLE_MFA=true
NEXT_PUBLIC_DISABLE_MFA=true

# ── MFA cookie signing ──────────────────────────────────────
MFA_COOKIE_SECRET=change-me-to-a-random-string-in-production

# ── Activation / Cron ────────────────────────────────────────
PROJECT_ACTIVATION_DELAY_MINUTES=5
CRON_CHECK_INTERVAL_MINUTES=3

# -- AI Provider Layer (new multi-provider orchestrator) --
AI_ORCHESTRATOR_ENABLED=true
AI_SYNC_WORKER=true
AI_WORKER_SECRET=166475914dfd0ffa7c8e1fdacaafc66f2df61e190458d5c821f06a8d3ecfa989
