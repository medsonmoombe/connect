# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Firebase (client-side) ───────────────────────────────────
# From: Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_REGION=us-central1

# ── Firebase Admin SDK (server-side only) ────────────────────
# From: Firebase Console → Project Settings → Service Accounts → Generate new private key
# The private key must keep its \n newlines — wrap the whole value in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Supabase (client-side) ───────────────────────────────────
# From: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Branding ─────────────────────────────────────────────────
# Product name shown across the UI, emails, and browser tabs.
# NEXT_PUBLIC_* values are inlined at build time — restart/rebuild after changing.
NEXT_PUBLIC_APP_NAME="Afri Connect"
NEXT_PUBLIC_APP_TAGLINE="Zambia Energy Market"
# Server-side name for email From lines and templates
APP_NAME="Afri Connect"
SUPPORT_EMAIL=support@africonnect.io

# ── Supabase Service Role (server-side only) ─────────────────
# From: Supabase Dashboard → Settings → API → service_role key
# Keep this secret — it bypasses all RLS policies.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Database (Postgres connection string) ──────────
# From: Supabase Dashboard → Settings → Database → Connection string → URI
# Required by web/migrate.mjs and web/supabase/reset.js / fresh.js
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Resend (email) ──────────────────────────────────────────
# From: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Afri Connect <noreply@yourdomain.com>

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MFA / OTP ────────────────────────────────────────────────
# Set to 'true' to bypass OTP for all users (use while email is not configured).
# Set to 'false' or remove to enforce MFA for admins/org owners as normal.
DISABLE_MFA=false

# ── MFA Cookie Secret ───────────────────────────────────────
# HMAC signing key for MFA verification cookies (edge-compatible).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MFA_COOKIE_SECRET=

# ── Project activation delay (minutes) ────────────────────────
# How long after scoring before a project becomes visible to investors.
# Production: 1440 (1 business day). Testing: 5
PROJECT_ACTIVATION_DELAY_MINUTES=1440

# ── Cron check interval (minutes) ────────────────────────────
# How often pg_cron checks for projects ready to activate.
# Production: 60. Testing: 3
CRON_CHECK_INTERVAL_MINUTES=60

# ── Support email ────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ── AI Provider Layer ────────────────────────────────────────
# Primary AI key (already used by legacy path)
GEMINI_API_KEY=

# Model for the legacy Gemini fallback path. Leave unset to use the same
# default as ai_provider_config.active_model (see ai_model_catalog for the
# list of live models — retired ids return 404 from Google).
GEMINI_MODEL=gemini-3.5-flash-lite

# Mistral API key (console.mistral.ai)
MISTRAL_API_KEY=

# DeepSeek API key (disabled by default in ai_model_catalog)
DEEPSEEK_API_KEY=

# Enable the new multi-provider orchestrator (true = new AI provider layer)
AI_ORCHESTRATOR_ENABLED=true

# true = run AI job inline after enqueue (Docker). false = cron worker (Vercel)
AI_SYNC_WORKER=true

# Protects /api/internal/ai-worker
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AI_WORKER_SECRET=

# ── AI Provider Layer ────────────────────────────────────────
# Primary AI provider key (already used by legacy path)
GEMINI_API_KEY=

# Model for the legacy Gemini fallback path (see ai_model_catalog).
GEMINI_MODEL=gemini-3.5-flash-lite

# Mistral API key (get from console.mistral.ai)
MISTRAL_API_KEY=

# DeepSeek API key (disabled by default in ai_model_catalog)
DEEPSEEK_API_KEY=

# Set to 'true' to enable the new multi-provider orchestrator.
# Leave unset (or 'false') to keep using the legacy Gemini path.
AI_ORCHESTRATOR_ENABLED=true

# Set to 'true' on Docker: runs the AI job inline after enqueue.
# On Vercel: leave false — the cron worker picks up jobs.
AI_SYNC_WORKER=true

# Secret for the internal /api/internal/ai-worker endpoint.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AI_WORKER_SECRET=
